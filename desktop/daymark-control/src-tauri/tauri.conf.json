{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Daymark Control",
  "version": "0.1.1",
  "identifier": "com.daymark.control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-windows-launcher.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daymark Control",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["daymark"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Daymark",
    "shortDescription": "Private team scheduling without shared calendars",
    "longDescription": "Daymark keeps employee calendars private while clients book clear, company-scoped appointment slots.",
    "resources": {
      "../../../artifacts/windows-stage/DaymarkRuntime.exe": "DaymarkRuntime.exe",
      "../../../artifacts/windows-stage/node/": "node",
      "../../../artifacts/windows-stage/DaymarkService.exe": "DaymarkService.exe",
      "../../../artifacts/windows-stage/DaymarkService.xml": "DaymarkService.xml",
      "../../../artifacts/windows-stage/cloudflared.exe": "cloudflared.exe",
      "../../../artifacts/windows-stage/dist/": "dist",
      "../../../artifacts/windows-stage/drizzle/": "drizzle",
      "../../../artifacts/windows-stage/runtime/": "runtime",
      "../../../artifacts/windows-stage/lib/": "lib",
      "../../../artifacts/windows-stage/package.json": "package.json",
      "../../../artifacts/windows-stage/node_modules/": "node_modules",
      "../../../artifacts/windows-stage/vc_redist.x64.exe": "vc_redist.x64.exe",
      "../../../artifacts/windows-stage/third-party-licenses/": "third-party-licenses"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "compression": "lzma",
        "startMenuFolder": "Daymark",
        "installerHooks": "../../../packaging/windows/installer-hooks.nsh",
        "headerImage": "../../../packaging/windows/assets/header.bmp",
        "sidebarImage": "../../../packaging/windows/assets/sidebar.bmp"
      }
    }
  }
}
