{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/with-wrangler-log.mjs dev",
    "build": "node scripts/with-wrangler-log.mjs build",
    "start": "node scripts/with-wrangler-log.mjs start",
    "runtime:start": "node --import tsx runtime/local/cli.ts start",
    "runtime:migrate": "node --import tsx runtime/local/cli.ts migrate",
    "runtime:backup": "node --import tsx runtime/local/cli.ts backup",
    "windows:verify-runtime": "node scripts/verify-runtime-manifest.mjs",
    "windows:stage": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-windows-runtime.ps1 -Clean",
    "windows:test-staged-migration": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/windows/staged-migration.test.ps1",
    "windows:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "unit": "vitest run",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern artifacts --ignore-pattern desktop/daymark-control/dist --ignore-pattern desktop/daymark-control/src-tauri/target",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.23.9",
    "wrangler": "4.92.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
