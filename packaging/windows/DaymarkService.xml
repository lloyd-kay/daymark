<service>
  <id>Daymark</id>
  <name>Daymark Booking Service</name>
  <description>Runs the private Daymark booking service on this computer.</description>
  <executable>%BASE%\node\node.exe</executable>
  <arguments>&quot;%BASE%\runtime\local\cli.ts&quot; start</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <env name="DAYMARK_DATA_DIR" value="%ProgramData%\Daymark" />
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="15 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>%ProgramData%\Daymark\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
